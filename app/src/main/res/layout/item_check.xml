<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvCheckName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#D6DEE9"
        android:gravity="center"
        android:padding="12dp"
        android:text="Contact Name"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#222222" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvCheckReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Reason: Routine Check-In"
            android:textSize="18sp"
            android:textColor="#5F6B7A" />

        <TextView
            android:id="@+id/tvCheckStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Status: Awaiting Response"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#222222" />

        <TextView
            android:id="@+id/tvCreatedDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#5F6B7A"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvClosedDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#5F6B7A"
            android:textSize="18sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvCheckTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Time: 05:00 remaining"
            android:textSize="18sp"
            android:textColor="#5F6B7A" />

        <Button
            android:id="@+id/btnResend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#1F3A5F"
            android:text="Resend Check-In"
            android:textSize="18sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#5F6B7A"
            android:text="Close Check-In"
            android:textSize="18sp"
            android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
